# Server configuration
PORT=8080

# Optional: how long to wait for an OMS API response, in seconds.
# Defaults to 600 (10 min) — /reason/pending has been taking 2-5 min.
# Raise it here instead of rebuilding if the endpoint degrades further.
# OMS_HTTP_TIMEOUT=600

# Optional: how long one OMS request may wait out rate limiting (HTTP 429 Too
# Many Requests) before the run stops, in seconds. Defaults to 900 (15 min).
# Each wait follows OMS's Retry-After header when it sends one.
# OMS_RATE_LIMIT_WAIT=900

# Optional: minimum gap between any two OMS requests, in milliseconds. Defaults
# to 1000 (≤60 requests/min). Every 429 doubles it for the rest of that run (up
# to 15s), so raise this if runs keep hitting the rate limit early.
# OMS_REQUEST_GAP_MS=1000

# Optional: outages fetched per /reason/pending call. Defaults to 500, i.e. the
# whole queue in one call — it takes about as long as a call for 10.
# OMS_PAGE_SIZE=500

# ==========================================
# USER PROFILE 1 (Default)
# Passcode must be exactly 6 digits; it unlocks this profile in the web UI.
# ==========================================
PASSCODE=<6 digits>
OMS_COMPANY_NAME=DGVCL
OMS_EMP_NO=<employee number>
OMS_PASSWORD=<OMS password>
OMS_APP_NAME=SFMS-Web

# ==========================================
# USER PROFILE 2
# ==========================================
PASSCODE_2=<6 digits>
OMS_COMPANY_NAME_2=DGVCL
OMS_EMP_NO_2=<employee number>
OMS_PASSWORD_2=<OMS password>
OMS_APP_NAME_2=SFMS-Web

# Additional profiles can be added as PASSCODE_3, OMS_EMP_NO_3, OMS_PASSWORD_3, etc.

# Optional: set RUN_MODE=server to start the HTTP server (Dockerfile sets this).
# Leave unset / empty for one-shot CLI mode.
# RUN_MODE=server
